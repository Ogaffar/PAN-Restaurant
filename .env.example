# ─── PAN Restaurant — environment variables ──────────────────────────────────
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# For local development, create a .env file in the project root.
# For Cloudflare Pages, set these in the Pages dashboard under
# Settings → Environment variables.

# ── Resend (email delivery) ───────────────────────────────────────────────────
# Sign up at https://resend.com — free tier supports 3,000 emails/month.
# 1. Verify your sending domain (panfayetteville.com) in the Resend dashboard.
# 2. Create an API key with "Sending access" scope.
# 3. Paste the key below.
#
# Emails sent from:
#   form@panfayetteville.com  → catering inquiry notifications to owner
#   hello@panfayetteville.com → confirmation emails to submitters
#
# If RESEND_API_KEY is missing, the catering form still accepts submissions
# but skips email delivery (useful during development).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Newsletter audience (Resend Audiences) ───────────────────────────────────
# Create an audience in the Resend dashboard under Audiences → New audience.
# Copy the audience ID (format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx) here.
# Used by /api/subscribe to add new contacts.
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Cloudflare Pages deployment notes ────────────────────────────────────────
# When deploying to Cloudflare Pages, enable the "nodejs_compat" compatibility
# flag in the Pages dashboard under Settings → Functions → Compatibility flags.
# This is required by transitive dependencies (e.g. the debug package).
#
# Also set RESEND_API_KEY under Settings → Environment variables → Production.
