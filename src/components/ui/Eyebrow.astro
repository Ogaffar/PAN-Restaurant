---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {}

const { class: className, ...rest } = Astro.props;
---

<p
  class:list={[
    'font-body text-xs font-medium tracking-[0.18em] uppercase text-sage-500',
    className,
  ]}
  {...rest}
>
  <slot />
</p>
