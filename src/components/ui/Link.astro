---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {}

const { class: className, ...rest } = Astro.props;
---

<a
  class:list={[
    'text-sage-700',
    'underline decoration-sage-300 underline-offset-[0.2em]',
    'hover:decoration-sage-700',
    'transition-[text-decoration-color] duration-150',
    'rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-sage-700',
    className,
  ]}
  {...rest}
>
  <slot />
</a>
