---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  description: string;
  ingredients: string[];
  price: string | null;
  sizes?: { label: string; price: string }[];
  dietary?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  availability?: string;
}

const {
  name,
  description,
  ingredients,
  price,
  sizes,
  dietary = [],
  image,
  imageAlt,
  availability = 'always',
} = Astro.props;

type Badge = { label: string; cls: string };
const BADGES: Record<string, Badge> = {
  vegetarian:           { label: 'Vegetarian', cls: 'bg-sage-50 text-sage-700 border-sage-200' },
  vegan:                { label: 'Vegan',      cls: 'bg-sage-500 text-paper border-sage-500' },
  'gluten-free-option': { label: 'GF option',  cls: 'bg-[#fffbeb] text-[#854d0e] border-[#fde68a]' },
  spicy:                { label: 'Spicy',      cls: 'bg-terracotta/10 text-terracotta border-terracotta/30' },
};

const activeBadges = dietary.filter(d => d in BADGES);
---

<article class="flex gap-4 py-5 border-b border-sage-50 last:border-0">
  <!-- Optional image or icon placeholder -->
  <div class="shrink-0 pt-0.5" aria-hidden={!image ? 'true' : undefined}>
    {image ? (
      <Image
        src={image}
        alt={imageAlt ?? name}
        width={96}
        height={96}
        class="w-24 h-24 rounded-lg object-cover"
        loading="lazy"
      />
    ) : (
      <div class="w-16 h-16 rounded-lg bg-sage-50 flex items-center justify-center text-sage-300">
        <Icon name="lucide:utensils" class="w-5 h-5" />
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <!-- Name + price -->
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-[1.375rem] leading-snug text-ink">{name}</h3>
      <div class="shrink-0 font-body tabular-nums text-ink ml-2 text-right">
        {price ? (
          <span class="text-lg font-medium">{price}</span>
        ) : sizes && sizes.length > 0 ? (
          <span class="text-sm text-ink-soft">{sizes.map(s => `${s.label} ${s.price}`).join(' / ')}</span>
        ) : (
          <abbr
            title="Ask in store"
            class="text-lg text-ink-soft no-underline cursor-help"
            aria-label="Price on request — ask in store"
          >—</abbr>
        )}
      </div>
    </div>

    <!-- Description -->
    <p class="mt-1.5 text-base text-ink-soft leading-relaxed">{description}</p>

    <!-- Ingredients -->
    {ingredients.length > 0 && (
      <p class="mt-1.5 text-[0.8125rem] text-ink-soft leading-normal">
        {ingredients.join(', ')}
      </p>
    )}

    <!-- Dietary badges -->
    {activeBadges.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5" role="list" aria-label="Dietary information">
        {activeBadges.map(d => (
          <span
            role="listitem"
            class:list={['inline-block text-xs px-2 py-0.5 rounded-full border font-medium', BADGES[d].cls]}
          >
            {BADGES[d].label}
          </span>
        ))}
      </div>
    )}

    <!-- Seasonal note -->
    {availability === 'seasonal' && (
      <p class="mt-2 text-xs text-ink-soft italic">Seasonal — ask about availability</p>
    )}
  </div>
</article>
