---
const { pathname } = Astro.url;

const navLinks = [
  { href: '/menu',     label: 'Menu' },
  { href: '/story',    label: 'Story' },
  { href: '/visit',    label: 'Visit' },
  { href: '/catering', label: 'Catering' },
  { href: '/press',    label: 'Press' },
] as const;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}

const TOAST_URL = 'https://www.toasttab.com/pan-fayetteville';
---

<header
  id="site-header"
  class="sticky top-0 z-[100] h-16 lg:h-[72px] border-b border-transparent transition-[border-color,background-color] duration-200"
>
  <!--
    Hidden checkbox drives CSS :has() animations (hamburger→X, overlay show).
    JS manages open/close state and programmatically toggles it.
    aria-hidden + tabindex=-1: never reached by keyboard or AT.
  -->
  <input
    type="checkbox"
    id="nav-toggle"
    class="peer sr-only"
    aria-hidden="true"
    tabindex="-1"
  />

  <!-- Inner bar -->
  <div class="h-full flex items-center justify-between gap-6 px-6 lg:px-10 max-w-content mx-auto">

    <!-- Wordmark -->
    <a
      href="/"
      aria-label="PAN home"
      class="font-display font-semibold text-2xl leading-none tracking-tight text-ink shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-700 focus-visible:ring-offset-2 rounded-sm"
    >
      pan
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-7">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'nav-link text-sm font-medium transition-colors duration-150',
            'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-700 focus-visible:ring-offset-2 rounded-sm',
            isActive(href) ? 'text-ink is-active' : 'text-ink-soft hover:text-ink',
          ]}
        >
          {label}
        </a>
      ))}

      <a
        href={TOAST_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium font-body bg-sage-500 text-paper rounded-sm hover:bg-sage-700 active:bg-sage-900 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-700 focus-visible:ring-offset-2"
      >
        Order Online
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </nav>

    <!-- Hamburger button (mobile only) -->
    <button
      type="button"
      id="nav-toggle-btn"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="hamburger-btn relative z-10 lg:hidden flex flex-col justify-center gap-[5px] w-10 h-10 -mr-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-700 focus-visible:ring-offset-2"
    >
      <span class="ham-bar ham-top  block h-[2px] w-[22px] mx-auto bg-ink origin-center transition-transform duration-200"></span>
      <span class="ham-bar ham-mid  block h-[2px] w-[22px] mx-auto bg-ink transition-opacity duration-200"></span>
      <span class="ham-bar ham-bot  block h-[2px] w-[22px] mx-auto bg-ink origin-center transition-transform duration-200"></span>
    </button>

  </div><!-- /inner bar -->

  <!-- Mobile overlay -->
  <div
    id="mobile-nav"
    class="mobile-nav fixed inset-0 top-0 bg-paper flex-col px-6 pt-24 pb-10 overflow-y-auto lg:hidden"
    role="dialog"
    aria-label="Navigation menu"
    aria-modal="true"
  >
    <nav aria-label="Primary">
      <ul class="flex flex-col gap-1">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'block py-3 font-display text-3xl tracking-tight transition-colors duration-150',
                'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-700 rounded-sm',
                isActive(href) ? 'text-ink' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-10">
      <a
        href={TOAST_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-full py-4 font-body font-medium text-base bg-sage-500 text-paper rounded-sm hover:bg-sage-700 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-700 focus-visible:ring-offset-2"
      >
        Order Online
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>
  </div><!-- /mobile-nav -->
</header>

<!-- Body scroll lock + overlay via :has() -->
<style is:global>
  body:has(#nav-toggle:checked) {
    overflow: hidden;
  }

  #site-header.scrolled {
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: var(--color-sage-100);
  }

  /* Hamburger → X animation via :has() */
  body:has(#nav-toggle:checked) .ham-top {
    transform: translateY(7px) rotate(45deg);
  }
  body:has(#nav-toggle:checked) .ham-mid {
    opacity: 0;
  }
  body:has(#nav-toggle:checked) .ham-bot {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<style>
  .mobile-nav {
    display: none;
  }
  :global(body:has(#nav-toggle:checked)) .mobile-nav {
    display: flex;
  }

  .nav-link.is-active {
    position: relative;
  }
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-sage-500);
    border-radius: 1px;
  }
</style>

<script>
  // Scroll → scrolled class
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 4);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle    = document.getElementById('nav-toggle') as HTMLInputElement | null;
  const btn       = document.getElementById('nav-toggle-btn') as HTMLButtonElement | null;
  const mobileNav = document.getElementById('mobile-nav');

  function syncAria(open: boolean): void {
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  }

  function openMenu(): void {
    if (toggle) toggle.checked = true;
    syncAria(true);
    // Move focus to first focusable element in the dialog
    const first = mobileNav?.querySelector<HTMLElement>('a[href], button:not([disabled])');
    first?.focus();
  }

  function closeMenu(): void {
    if (toggle) toggle.checked = false;
    syncAria(false);
    btn?.focus();
  }

  btn?.addEventListener('click', () => {
    toggle?.checked ? closeMenu() : openMenu();
  });

  // Focus trap: keep Tab/Shift+Tab inside the open dialog
  mobileNav?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!toggle?.checked || e.key !== 'Tab') return;
    const focusables = Array.from(
      mobileNav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    );
    const first = focusables[0];
    const last  = focusables[focusables.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
    }
  });

  // Escape closes and returns focus to the trigger
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && toggle?.checked) closeMenu();
  });

  // Close on nav link click (same-page or client-side navigation)
  mobileNav?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', closeMenu);
  });
</script>
