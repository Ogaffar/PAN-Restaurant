---
import { Icon } from 'astro-icon/components';
import NewsletterForm from './NewsletterForm.astro';

const currentYear = new Date().getFullYear();

const MAPS_URL   = 'https://maps.google.com/?q=PAN+105+Hay+St+Fayetteville+NC+28301';
const PHONE      = '(910) 491-3105';
const PHONE_TEL  = 'tel:+19104913105';
const IG_URL     = 'https://www.instagram.com/pansandwiches/';
const FB_URL     = 'https://www.facebook.com/panfaync/';

const hours = [
  { days: 'Mon – Thu', time: '11 am – 7 pm' },
  { days: 'Friday',    time: '11 am – 8 pm' },
  { days: 'Saturday',  time: '10 am – 5 pm' },
  { days: 'Sunday',    time: 'Closed' },
] as const;
---

<footer class="bg-ink text-paper">

  <!-- Main columns -->
  <div class="max-w-content mx-auto px-6 lg:px-10 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">

      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-5">
        <a
          href="/"
          aria-label="PAN home"
          class="font-display font-semibold text-3xl tracking-tight text-paper w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 focus-visible:ring-offset-2 focus-visible:ring-offset-ink rounded-sm"
        >
          pan
        </a>
        <p class="font-body text-sm leading-relaxed text-paper/70 max-w-[22ch] italic">
          &ldquo;Life, Liberty, and the Prosciutt&rsquo; of happiness.&rdquo;
        </p>

        <!-- Best of Fayetteville badge -->
        <div
          class="inline-flex items-center gap-2 w-fit px-3 py-1.5 rounded-full border border-mustard/40 text-mustard"
          aria-label="Best of Fayetteville 2024 and 2025"
        >
          <Icon name="lucide:star" class="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
          <span class="font-body text-xs font-medium tracking-wide">
            Best of Fayetteville &rsquo;24 &amp; &rsquo;25
          </span>
        </div>
      </div>

      <!-- Col 2: Visit -->
      <div class="flex flex-col gap-5">
        <p class="font-display text-lg tracking-tight text-paper">Visit</p>

        <address class="not-italic flex flex-col gap-3 font-body text-sm text-paper/70">
          <a
            href={MAPS_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="105 Hay St, Fayetteville, NC 28301 (opens map in new tab)"
            class="hover:text-paper transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 rounded-sm"
          >
            105 Hay St<br />
            Fayetteville, NC 28301
          </a>
          <a
            href={PHONE_TEL}
            class="hover:text-paper transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 rounded-sm w-fit"
          >
            {PHONE}
          </a>
        </address>

        <!-- Hours -->
        <table class="text-sm w-full">
          <caption class="sr-only">Restaurant hours</caption>
          <tbody>
            {hours.map(({ days, time }) => (
              <tr class="border-b border-paper/10 last:border-0">
                <th scope="row" class="py-2 pr-4 font-medium text-paper/60 whitespace-nowrap text-left">{days}</th>
                <td class="py-2 text-paper/90">{time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Col 3: Follow + Subscribe -->
      <div class="flex flex-col gap-5">
        <p class="font-display text-lg tracking-tight text-paper">Follow</p>

        <div class="flex items-center gap-4">
          <a
            href={IG_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="PAN on Instagram (opens in new tab)"
            class="text-paper/60 hover:text-paper transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 focus-visible:ring-offset-1 focus-visible:ring-offset-ink rounded-sm p-1 -ml-1"
          >
            <Icon name="simple-icons:instagram" class="w-5 h-5" aria-hidden="true" />
          </a>
          <a
            href={FB_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="PAN on Facebook (opens in new tab)"
            class="text-paper/60 hover:text-paper transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 focus-visible:ring-offset-1 focus-visible:ring-offset-ink rounded-sm p-1"
          >
            <Icon name="simple-icons:facebook" class="w-5 h-5" aria-hidden="true" />
          </a>
        </div>

        <!-- Email subscribe -->
        <div class="mt-2">
          <p class="font-body text-sm font-medium text-paper/80 mb-3">
            Stay in the loop
          </p>
          <NewsletterForm inputId="footer-email" variant="dark" />
        </div>
      </div>

    </div><!-- /grid -->
  </div>

  <!-- Bottom strip -->
  <div class="border-t border-paper/10">
    <div class="max-w-content mx-auto px-6 lg:px-10 py-5 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="font-body text-xs text-paper/50">
        &copy; {currentYear} Graybill Hospitality Co. LLC. All rights reserved.
      </p>
      <nav aria-label="Footer" class="flex items-center gap-5">
        <a
          href="/privacy"
          class="font-body text-xs text-paper/50 hover:text-paper/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 rounded-sm"
        >
          Privacy
        </a>
        <a
          href="/accessibility"
          class="font-body text-xs text-paper/50 hover:text-paper/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-300 rounded-sm"
        >
          Accessibility
        </a>
      </nav>
    </div>
  </div>

</footer>
